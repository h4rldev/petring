{erl_opts, [debug_info]}.

{deps, [
  {eqwalizer_support,
    {git_subdir,
      "https://github.com/whatsapp/erlang-language-platform.git",
      {branch, "main"},
      "eqwalizer/eqwalizer_support"}},
  {errm_sqlite,    {git, "https://github.com/h4rldev/errm-SQLite",    {branch, "main"}}},
  {errm_http,      {git, "https://github.com/h4rldev/errm-HTTP",      {branch, "main"}}},
  {errm_env,       {git, "https://github.com/h4rldev/errm-ENV",       {branch, "main"}}},
  {errm_uuid,      {git, "https://github.com/h4rldev/errm-UUID",      {branch, "main"}}},
  {errm_jwt,       {git, "https://github.com/h4rldev/errm-JWT",       {branch, "main"}}},
  {errm_json,      {git, "https://github.com/h4rldev/errm-JSON",      {branch, "main"}}},
  {errm_argon,     {git, "https://github.com/h4rldev/errm-ARGON",     {branch, "main"}}},
  {errm_ws,        {git, "https://github.com/h4rldev/errm-WS",        {branch, "main"}}},
  {errm_cmark_gfm, {git, "https://github.com/h4rldev/errm-cmark-gfm", {branch, "main"}}}
]}.

{profiles, [
  {migrations, [
    {src_dirs, ["migrator"]},
    {escript_name, "migrator"},
    {escript_main_app, migrator},
    {escript_incl_apps, [errm_sqlite]},
    {escript_incl_priv, [{errm_sqlite, "*.so"}]},
    {escript_emu_args, "%%! +sbtu +A1\n"}
  ]},
  {prod, [
    {erl_opts, [no_debug_info, deterministic, warnings_as_errors, compressed, {optimize, 3}]},
    {escript_name, "petring"},
    {escript_main_app, petring},
    {escript_incl_priv, [{errm_sqlite, "*.so"}, {errm_http, "*.so"}, {errm_argon, "*.so"}, {errm_cmark_gfm, "*.so"}]},
    {escript_incl_apps, [errm_sqlite, errm_http, errm_env, errm_uuid, errm_jwt, errm_json, errm_argon, errm_ws, errm_cmark_gfm]},
    {escript_emu_args, "%%! +sbtu +A1\n"}
  ]}
]}.
